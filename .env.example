# Where the API lives. Leave empty in development: Vite forwards /api to VITE_PROXY_TARGET.
# Set it (to e.g. https://api.example.com/api/v1) when the API is on another origin; the back-end must then list this site in CORS_ORIGINS.
VITE_API_BASE=

# Development only: where `npm run dev` forwards /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000
